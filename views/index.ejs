<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
  <title>Country Explorer</title>
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="icon" type="image/x-icon" href="/images/favcon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body>
  <div class="container">

    <!-- SEARCH -->
    <div class="search-container">
      <form action="/search" method="POST">
        <input 
          type="text" 
          name="country" 
          placeholder="Your gateway to every country..." 
          required
        >
        <button type="submit">↩</button>
      </form>
    </div>
    
    <% if (!result) { %>
      <p class="error"><%= error %><br>😤😮‍💨</p>
      <% } else { %>
        <div class="flag-container">
          <div class="card">
            <h1 id="country-name">
              <%= result ? result.names.official : "Loading...🏃🏿‍➡️" %>
            </h1>
    
            <img
              id="flag"
              src="<%= result.flag.url_svg %>" 
              alt="<%= result.flag.description %>"
              class="flag"
            >
  
      <span id="currency-symbol" class="currency-symbol">
        <%= result 
        ? Object.values(result.currencies || {})[0]?.symbol || "?" 
        : "?😱"
        %>
      </span>
        </div>
  
          <div class="info">
            <p>
              <strong>Capital:</strong>
               <span id="capital">
                <%= result ? result.capitals?.[0].name : "Loading...🏃🏿‍➡️" %>
              </span>
           </p>

            <p>
              <strong>Population:</strong>
               <span id="population">
                <%= result 
                ? result.population ? result.population.toLocaleString() : "N/A" 
                : "Loading...🏃🏿‍➡️"%>
              </span>
           </p>

            <p>
              <strong>Currency:</strong>
               <span id="currency">
                <%= result 
                ? Object.values(result.currencies || {})[0]?.name || "N/A" 
                : "Lading...🏃🏿‍➡️"%>
              </span> 
            </p>

            <p>
              <strong>Region:</strong>
               <span id="region">
                <%= result ? result.region : "Loading...🏃🏿‍➡️" %>
              </span> 
            </p>
          </div>
        </div>
    <% } %>

  </div>

  <footer class="footer">
    <p>© <%= new Date().getFullYear() %> Country Explorer | sheyshey.io | picsack.gh</p>
  </footer>

  <script>
    async function loadCarousel() {
    try {
      const res = await fetch("/api/countries");
      const countries = await res.json();

      if (!countries.length) return;

      let index = 0;

      function updateUI(country) {
        document.getElementById("country-name").textContent = country.name;
        document.getElementById("flag").src = country.flag;
        document.getElementById("capital").textContent = country.capital;
        document.getElementById("population").textContent = country.population.toLocaleString();
        document.getElementById("currency").textContent = country.currency;
        document.getElementById("currency-symbol").textContent = country.symbol;
        document.getElementById("region").textContent = country.region;
      }

      // show first instantly
      updateUI(countries[0]);

      // rotate every 3 seconds
      setInterval(() => {
        index = (index + 1) % countries.length;
        updateUI(countries[index]);
      }, 5000);

    } catch (err) {
      console.error("AJAX error:", err);
    }
  }
    const hasResult = <%= !!result %>;

  if (hasResult) {
    setTimeout(loadCarousel, 4000);
  } else {
    loadCarousel();
  }
  </script>
</body>
</html>